<main>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="index.html">Home</a> › <span>Video Gallery</span>
  </nav>

  <h1>Video Gallery</h1>
  <p class="lead">Free demonstrations of asanas, Padmasana, pranayama, and meditation — filmed in our studio, unedited.</p>

  <!-- SEARCH + SORT CONTROLS -->
  <div class="gallery-controls">
    <input type="search" id="video-search" placeholder="Search videos…" aria-label="Search videos">
    <select id="video-sort" aria-label="Sort videos">
      <option value="date-desc">Newest first</option>
      <option value="date-asc">Oldest first</option>
      <option value="title-asc">Title A–Z</option>
      <option value="duration-asc">Shortest first</option>
      <option value="duration-desc">Longest first</option>
    </select>
  </div>

  <!-- FILTERS -->
  <div class="gallery-filters" data-target="video-grid">
    <button class="active" data-filter="all">All</button>
    <button data-filter="featured">Featured</button>
    <button data-filter="asana">Asana</button>
    <button data-filter="padmasana">Padmasana</button>
    <button data-filter="pranayama">Pranayama</button>
    <button data-filter="meditation">Meditation</button>
    <button data-filter="beginner">Beginner</button>
  </div>

  <!-- GRID (filled by gallery.js) -->
  <div class="video-grid" id="video-grid" aria-live="polite">
    <!-- Skeleton cards shown until JSON loads -->
    <div class="skeleton skeleton-video"></div>
    <div class="skeleton skeleton-video"></div>
    <div class="skeleton skeleton-video"></div>
  </div>

  <p id="video-empty" class="empty-state" hidden>No videos match your search.</p>

  <p class="note">Videos are filmed in-studio, no music, no filters. What you see is what we teach.</p>
</main>

